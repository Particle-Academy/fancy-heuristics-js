{
  "name": "@particle-academy/fancy-heuristics-js",
  "version": "0.2.0",
  "description": "Zero-dependency browser collector SDK for Fancy Heuristics \u2014 batches human + agent interaction events (pageview, click, scroll, pointer heatmap, dwell) and ships them via navigator.sendBeacon to a fancy-heuristics PHP ingestion endpoint. Mirrors the PHP record surface. Optional peer @particle-academy/fancy-auto-common taps the agent activity bus.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-heuristics-js.git"
  },
  "homepage": "https://github.com/Particle-Academy/fancy-heuristics-js#readme",
  "bugs": "https://github.com/Particle-Academy/fancy-heuristics-js/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/fancy-heuristics.global.min.js",
  "jsdelivr": "./dist/fancy-heuristics.global.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./global": "./dist/fancy-heuristics.global.min.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/global.js",
    "./dist/fancy-heuristics.global.min.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && eslint .",
    "test": "node --test",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "analytics",
    "heatmap",
    "collector",
    "sendBeacon",
    "telemetry",
    "agent",
    "human-plus-ux",
    "fancy"
  ],
  "peerDependencies": {
    "@particle-academy/fancy-auto-common": ">=0.1 <2.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@particle-academy/fancy-auto-common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
